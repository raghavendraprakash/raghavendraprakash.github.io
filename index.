<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Raghavendra Prakash — Solutions Architecture</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#13212C;
    --blueprint-deep:#163752;
    --blueprint-mid:#23516F;
    --blueprint-line:#8FBBD4;
    --paper:#EEF1EE;
    --paper-2:#E2E8E2;
    --brass:#C89A3D;
    --slate:#54707E;
    --rule: rgba(19,33,44,0.14);
    --maxw: 880px;
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    font-size:17px;
    line-height:1.65;
    -webkit-font-smoothing:antialiased;
  }

  ::selection{ background:var(--brass); color:var(--ink); }

  h1,h2,h3{
    font-family:'Space Grotesk', sans-serif;
    margin:0;
    letter-spacing:-0.01em;
  }

  a{ color:inherit; }

  .wrap{
    max-width:var(--maxw);
    margin:0 auto;
    padding-left:32px;
    padding-right:32px;
  }

  .mono{
    font-family:'IBM Plex Mono', monospace;
    letter-spacing:0.02em;
  }

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    background:
      linear-gradient(var(--blueprint-deep), var(--blueprint-deep)) padding-box,
      repeating-linear-gradient(0deg, rgba(143,187,212,0.08) 0 1px, transparent 1px 40px),
      repeating-linear-gradient(90deg, rgba(143,187,212,0.08) 0 1px, transparent 1px 40px);
    color:#F2F6F8;
    padding:56px 0 44px;
    overflow:hidden;
  }

  .reg-mark{
    position:absolute;
    width:22px; height:22px;
    opacity:0.55;
  }
  .reg-mark::before, .reg-mark::after{
    content:"";
    position:absolute;
    background:var(--blueprint-line);
  }
  .reg-mark::before{ width:100%; height:1px; top:50%; left:0; }
  .reg-mark::after{ height:100%; width:1px; left:50%; top:0; }
  .reg-mark.tl{ top:18px; left:18px; }
  .reg-mark.tr{ top:18px; right:18px; }
  .reg-mark.bl{ bottom:18px; left:18px; }
  .reg-mark.br{ bottom:18px; right:18px; }

  .hero .wrap{ position:relative; }

  .drawing-no{
    font-size:12px;
    color:var(--blueprint-line);
    margin-bottom:28px;
    display:flex;
    gap:18px;
    flex-wrap:wrap;
  }
  .drawing-no span b{
    color:#F2F6F8;
    font-weight:500;
  }

  .hero h1{
    font-size:clamp(30px, 5vw, 46px);
    font-weight:600;
    line-height:1.12;
    max-width:11ch;
  }

  .hero .role{
    margin-top:14px;
    font-size:clamp(15px,2.1vw,18px);
    color:var(--blueprint-line);
    max-width:44ch;
    font-weight:400;
  }

  .hero .lede{
    margin-top:26px;
    max-width:62ch;
    font-size:15.5px;
    color:#D6E4EC;
    border-left:2px solid var(--brass);
    padding-left:18px;
  }

  .title-block{
    margin-top:40px;
    border-top:1px solid rgba(143,187,212,0.35);
    padding-top:16px;
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    gap:18px;
  }
  .tb-field{ font-size:11.5px; }
  .tb-field .k{
    color:var(--blueprint-line);
    display:block;
    margin-bottom:4px;
  }
  .tb-field .v{
    color:#F2F6F8;
    font-size:13px;
  }

  /* ---------- STAT STRIP ---------- */
  .stats{
    background:var(--blueprint-mid);
    border-top:1px solid rgba(143,187,212,0.3);
    border-bottom:1px solid rgba(0,0,0,0.15);
  }
  .stats .wrap{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    padding:0;
  }
  .stat{
    padding:22px 18px;
    border-left:1px solid rgba(143,187,212,0.25);
    color:#EFF5F8;
  }
  .stat:first-child{ border-left:none; padding-left:0; }
  .stat .n{
    font-family:'Space Grotesk', sans-serif;
    font-size:clamp(20px,3vw,27px);
    font-weight:600;
    color:#fff;
  }
  .stat .l{
    margin-top:4px;
    font-size:11.5px;
    color:var(--blueprint-line);
    line-height:1.4;
  }

  /* ---------- SECTIONS ---------- */
  section{ padding:60px 0; }
  section.alt{ background:var(--paper-2); }
  section.dark{
    background:var(--blueprint-deep);
    color:#F2F6F8;
  }

  .sec-head{
    display:flex;
    align-items:baseline;
    gap:14px;
    margin-bottom:30px;
  }
  .sec-num{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    color:var(--brass);
    border:1px solid var(--brass);
    border-radius:2px;
    padding:2px 7px;
    flex-shrink:0;
  }
  section.dark .sec-num{ color:#E9CD8C; border-color:#E9CD8C; }
  .sec-head h2{
    font-size:22px;
    font-weight:600;
  }

  .summary p{
    max-width:66ch;
    font-size:16.5px;
    color:var(--ink);
  }

  /* Experience */
  .role-block{
    display:grid;
    grid-template-columns:200px 1fr;
    gap:32px;
  }
  .role-meta{
    border-left:2px solid var(--brass);
    padding-left:18px;
  }
  .role-meta .org{
    font-family:'Space Grotesk', sans-serif;
    font-weight:600;
    font-size:18px;
  }
  .role-meta .fn{
    margin-top:6px;
    font-size:13.5px;
    color:var(--slate);
    line-height:1.5;
  }
  .role-list{
    list-style:none;
    margin:0; padding:0;
  }
  .role-list li{
    position:relative;
    padding:14px 0;
    padding-left:26px;
    border-top:1px solid var(--rule);
    font-size:15.5px;
  }
  .role-list li:first-child{ border-top:none; padding-top:0; }
  .role-list li::before{
    content:"";
    position:absolute;
    left:2px; top:22px;
    width:9px; height:1px;
    background:var(--brass);
  }
  .role-list li b{ font-weight:600; }

  /* Accomplishments grid */
  .accom-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:1px;
    background:var(--rule);
    border:1px solid var(--rule);
  }
  .accom{
    background:var(--paper);
    padding:20px 22px;
    font-size:14.8px;
  }
  .accom .tag{
    display:block;
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color:var(--slate);
    margin-bottom:8px;
  }

  /* Core expertise — ledger style */
  .expertise-list{
    list-style:none;
    margin:0; padding:0;
    display:grid;
    grid-template-columns:1fr 1fr;
    column-gap:40px;
  }
  .expertise-list li{
    display:flex;
    align-items:baseline;
    gap:12px;
    padding:13px 0;
    border-top:1px solid rgba(143,187,212,0.22);
    font-size:15px;
  }
  .expertise-list li:nth-child(-n+2){ border-top:1px solid rgba(143,187,212,0.4); }
  .expertise-list .idx{
    font-family:'IBM Plex Mono', monospace;
    font-size:11px;
    color:var(--brass);
    flex-shrink:0;
  }

  /* Certifications ledger */
  .cert-ledger{
    width:100%;
    border-collapse:collapse;
  }
  .cert-ledger tr{ border-top:1px solid var(--rule); }
  .cert-ledger tr:first-child{ border-top:none; }
  .cert-ledger td{
    padding:14px 0;
    font-size:15px;
    vertical-align:baseline;
  }
  .cert-ledger td.code{
    font-family:'IBM Plex Mono', monospace;
    font-size:12px;
    color:var(--slate);
    width:80px;
    white-space:nowrap;
  }

  /* Education */
  .edu-item{
    padding:18px 0;
    border-top:1px solid var(--rule);
  }
  .edu-item:first-child{ border-top:none; }
  .edu-item .deg{
    font-family:'Space Grotesk', sans-serif;
    font-weight:600;
    font-size:16.5px;
  }
  .edu-item .inst{
    margin-top:3px;
    font-size:14px;
    color:var(--slate);
  }

  footer{
    background:var(--blueprint-deep);
    color:var(--blueprint-line);
    padding:30px 0;
    font-size:12px;
    display:flex;
    justify-content:space-between;
    flex-wrap:wrap;
    gap:10px;
  }

  @media (max-width:720px){
    .wrap{ padding-left:22px; padding-right:22px; }
    .title-block{ grid-template-columns:1fr 1fr; }
    .stats .wrap{ grid-template-columns:1fr 1fr; }
    .stat{ border-left:none; border-top:1px solid rgba(143,187,212,0.25); padding-left:0; }
    .stat:nth-child(odd){ padding-right:18px; }
    .stat:nth-child(-n+2){ border-top:none; }
    .role-block{ grid-template-columns:1fr; }
    .accom-grid{ grid-template-columns:1fr; }
    .expertise-list{ grid-template-columns:1fr; }
  }
</style>
</head>
